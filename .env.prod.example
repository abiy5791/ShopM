# =====================================================================
# ShopM — PRODUCTION environment reference for docker-compose.prod.yml.
# Copy to `.env.prod`, fill real values, and NEVER commit it.
# Differences from .env.example are called out inline.
# =====================================================================

# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.prod
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=shop.example.com

# ---- Database (PostgreSQL 16 — a managed instance is recommended) ----
POSTGRES_DB=shopm
POSTGRES_USER=shopm
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis / Celery ----
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT ----
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH=true
JWT_BLACKLIST_AFTER_ROTATION=true

# ---- CORS / hosts — must be the real frontend origin(s), never a wildcard ----
CORS_ALLOWED_ORIGINS=https://shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com

# ---- TLS (nginx sits in front; Django trusts its X-Forwarded-Proto) ----
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# ---- Object storage ----
# Point receipts/expense images at S3-compatible storage in prod.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- Defaults ----
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# ---- Email ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@shop.example.com
OWNER_DAILY_SUMMARY_ENABLED=true

# ---- Notification thresholds ----
LARGE_EXPENSE_THRESHOLD=100000
LARGE_VOID_THRESHOLD=100000
FAILED_LOGIN_THRESHOLD=5

# ---- Backups — mount a persistent volume/object store at this path ----
BACKUP_DIR=/app/backups

# ---- Hardening & observability ----
THROTTLE_LOGIN=10/min
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Frontend build arg (baked in at image build time) ----
VITE_API_BASE_URL=https://shop.example.com/api/v1
