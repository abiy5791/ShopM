# =====================================================================
# ShopM — environment reference. Copy to `.env` and fill real values.
# Never commit a real .env (see .gitignore). This file documents EVERY var.
# =====================================================================

# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod-use-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- Database (PostgreSQL 16) ----
POSTGRES_DB=shopm
POSTGRES_USER=shopm
POSTGRES_PASSWORD=shopm
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full DSN overrides the discrete vars above when set.
# DATABASE_URL=postgres://shopm:shopm@db:5432/shopm

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- JWT (djangorestframework-simplejwt) ----
JWT_ACCESS_LIFETIME_MIN=30
JWT_REFRESH_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH=true
JWT_BLACKLIST_AFTER_ROTATION=true

# ---- CORS / hosts ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---- Object storage (receipt / expense images) ----
# dev: local filesystem. prod: S3-compatible.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- Defaults ----
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# ---- Email (Phase 6 owner summaries; dev uses console/mailhog) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@shopm.local
# Feature flag: daily 06:00 email summary to each owner (WhatsApp is stubbed).
OWNER_DAILY_SUMMARY_ENABLED=false

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
