# Production image: multi-stage build, non-root user, gunicorn (plan §8).
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Build wheels for the project + all runtime deps (with index available here).
COPY pyproject.toml ./
RUN pip install --upgrade pip \
    && pip wheel --wheel-dir /wheels ".[prod]"


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.prod \
    PYTHONPATH=/app

WORKDIR /app

# libpq5 for psycopg; postgresql-client provides pg_dump/pg_restore for backups.
# The base image's client (>= the Postgres 16 server) can dump it — pg_dump only
# refuses a server NEWER than the client, never an older/equal one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 postgresql-client curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r shopm && useradd -r -g shopm -d /app shopm

# Install everything from the pre-built wheels — no index, no build step. The
# project wheel is metadata-only (py-modules=[]); the app code below runs via
# PYTHONPATH=/app.
COPY --from=builder /wheels /wheels
RUN pip install --no-index --find-links=/wheels "shopm-backend[prod]" \
    && rm -rf /wheels

COPY . .
COPY docker/entrypoint.prod.sh /entrypoint.sh
# Pre-create the mount points so Docker seeds the named volumes with shopm's
# ownership (a fresh volume inherits the image dir's owner). Without this the
# non-root user can't write collected static / media / backups.
RUN mkdir -p /app/staticfiles /app/media /app/backups \
    && chmod +x /entrypoint.sh \
    && chown -R shopm:shopm /app

USER shopm
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "60"]
