# Normalize line endings. Shell scripts and Dockerfiles MUST stay LF or they
# break inside Linux containers on Windows checkouts (e.g. "/bin/sh\r not found").
* text=auto eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.ico binary
*.xlsx binary
*.pdf binary
